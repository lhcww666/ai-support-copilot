APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=data/support_copilot.db

# Optional: without these values the application runs in deterministic offline mode.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_TOKENS=160

# OpenAI-compatible alternative:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: without a key the application uses deterministic local hash embeddings.
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

VECTOR_STORE=memory
PGVECTOR_DSN=

MAX_UPLOAD_BYTES=2097152
