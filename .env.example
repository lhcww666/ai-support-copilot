APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=data/support_copilot.db

# Optional: without these values the application runs in deterministic offline mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: without a key the application uses deterministic local hash embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_BYTES=2097152
