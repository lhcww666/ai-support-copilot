APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=data/support_copilot.db

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_TOKENS=160

# DeepSeek chat key does not replace an embedding provider.
# Leave this empty to use deterministic local hash embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
